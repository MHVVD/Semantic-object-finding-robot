<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>semantic_nav_bringup</name>
  <version>0.1.0</version>
  <description>Launch files, worlds, parameter YAML and RViz configs for the Semantic Object-Finding Robot.</description>
  <maintainer email="mahmudlawal75@gmail.com">Mahmud</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>semantic_nav_interfaces</exec_depend>
  <exec_depend>semantic_nav_perception</exec_depend>
  <exec_depend>semantic_nav_mapping</exec_depend>
  <exec_depend>semantic_nav_commander</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
