<?xml version="1.0"?>
<sdf version="1.9">
  <model name="potted_plant">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <pose>0 0 0.2 0 0 0</pose>
        <geometry><cylinder><radius>0.19</radius><length>0.4</length></cylinder></geometry>
      </collision>
      <visual name="pot">
        <geometry><mesh><uri>model://potted_plant/meshes/pot.obj</uri></mesh></geometry>
        <material>
          <ambient>0.55 0.27 0.16 1</ambient>
          <diffuse>0.72 0.36 0.2 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
          <pbr><metal><metalness>0.0</metalness><roughness>0.85</roughness></metal></pbr>
        </material>
      </visual>
      <visual name="leaves">
        <geometry><mesh><uri>model://potted_plant/meshes/leaves.obj</uri></mesh></geometry>
        <material>
          <ambient>0.08 0.3 0.08 1</ambient>
          <diffuse>0.15 0.5 0.13 1</diffuse>
          <specular>0.1 0.15 0.1 1</specular>
          <pbr><metal><metalness>0.0</metalness><roughness>0.6</roughness></metal></pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
