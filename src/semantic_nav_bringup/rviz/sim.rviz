Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Help Height: 0
    Tree Height: 400
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 12
      Reference Frame: <Fixed Frame>
      Color: 160; 160; 164
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Arrows: false
      Show Axes: true
      Show Names: false
      Marker Scale: 0.3
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Topic:
        Value: /scan
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Size (m): 0.04
      Style: Flat Squares
      Color Transformer: FlatColor
      Color: 255; 40; 40
      Decay Time: 0
    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Enabled: true
      Topic:
        Value: /odom
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Keep: 1
      Shape:
        Value: Arrow
        Color: 255; 200; 0
        Shaft Length: 0.4
        Shaft Radius: 0.03
        Head Length: 0.1
        Head Radius: 0.06
      Covariance:
        Value: false
    - Class: rviz_default_plugins/Image
      Name: RGB
      Enabled: true
      Topic:
        Value: /oakd/rgb/preview/image_raw
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Normalize Range: true
    - Class: rviz_default_plugins/Image
      Name: Depth
      Enabled: true
      Topic:
        Value: /oakd/rgb/preview/depth
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Normalize Range: false
      Min Value: 0
      Max Value: 6
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 15
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 60
      X: 0
      Y: 0
      Target Frame: base_link
    Saved: ~
Window Geometry:
  Width: 1400
  Height: 900
  Displays:
    collapsed: false
  RGB:
    collapsed: false
  Depth:
    collapsed: false
